// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// MODELS
// ============================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         String   @default("SECURITY")
  isActive     Boolean  @default(true)
  
  // LDAP fields
  ldapDn       String?  // Distinguished Name if user originated from LDAP
  ldapSyncedAt DateTime? // Last LDAP sync timestamp
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  createdVisits TruckVisit[]
  auditLogs     AuditLog[]
}

// LDAP Configuration (singleton pattern)
model LdapConfig {
  id                String   @id @default("singleton")
  enabled           Boolean  @default(false)
  
  // Connection settings
  host              String   @default("")
  port              Int      @default(389)
  connectionMode    String   @default("LDAP") // LDAP, LDAPS, STARTTLS
  
  // TLS settings
  tlsRejectUnauthorized Boolean @default(true)
  tlsCaCert         String?  // PEM certificate content
  
  // Bind credentials
  baseDn            String   @default("")
  bindDn            String   @default("")
  bindPasswordEnc   String   @default("") // Encrypted at rest
  
  // User search configuration
  userSearchFilter  String   @default("(sAMAccountName={{username}})")
  userAttributes    String   @default("cn,mail,memberOf,userAccountControl,accountExpires")
  
  // OU selection (JSON array of DN strings)
  selectedOUs       String   @default("[]")
  
  // Group authorization
  groupAuthEnabled  Boolean  @default(false)
  groupAuthMode     String   @default("highest_role_wins") // highest_role_wins, merge_permissions
  groupAuthDefaultRole String @default("SECURITY")
  groupMappingRules String   @default("[]") // JSON array of { groupDn, role, priority }
  groupAllowList    String   @default("[]") // JSON array of group DNs (if set, user must be in one)
  groupDenyList     String   @default("[]") // JSON array of group DNs (if user is in one, deny access)
  
  // Timeouts
  connectTimeout    Int      @default(5000)
  searchTimeout     Int      @default(10000)
  
  // Disable local fallback option
  disableLocalFallback Boolean @default(false)
  
  // Audit
  updatedAt         DateTime @updatedAt
  updatedById       String?
}

model Dock {
  id         String @id @default(uuid())
  name       String @unique
  dockNumber Int    @unique
  
  dockType       String  @default("BOTH")
  hasReeferPower Boolean @default(false)
  hazmatOk       Boolean @default(false)
  maxLength      Float?
  dockHeight     Float?
  
  status String @default("AVAILABLE")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  visits TruckVisit[]
}

model TruckVisit {
  id           String @id @default(uuid())
  truckPlate   String
  trailerPlate String?
  carrier      String?
  driverName   String?
  driverPhone  String?
  loadType     String @default("INBOUND")
  orderRef     String?
  priority     String @default("NORMAL")
  status       String @default("NEW")
  
  assignedDock   Dock?   @relation(fields: [assignedDockId], references: [id])
  assignedDockId String?
  
  createdAt   DateTime  @default(now())
  scheduledAt DateTime?
  arrivedAt   DateTime?
  calledAt    DateTime?
  dockedAt    DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  leftAt      DateTime?
  
  notes         String?
  flags         String?
  queuePosition Int?
  
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String
  auditLogs   AuditLog[]
  
  @@index([status])
  @@index([truckPlate])
  @@index([createdAt])
}

model Display {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String @id @default(uuid())
  action     String
  entityType String
  entityId   String
  
  beforeState String?
  afterState  String?
  metadata    String?
  
  createdAt DateTime @default(now())
  
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  visit   TruckVisit? @relation(fields: [visitId], references: [id])
  visitId String?
  
  @@index([entityType, entityId])
  @@index([createdAt])
}
