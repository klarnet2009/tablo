# Copy to .env and fill in. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Local development. In Docker this defaults to file:/app/data/tablo.db.
DATABASE_URL="file:./dev.db"

# --- Authentication -------------------------------------------------------
# Required. openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Required in production. 32 bytes of hex: openssl rand -hex 32
# Encrypts the LDAP service-account password at rest. If unset, the app refuses
# to start in production; in development it falls back to a well-known key.
LDAP_ENCRYPTION_KEY=""

# Password of the initial "admin" account. Only read while creating a fresh
# database (docker-entrypoint.sh / `prisma db seed`); ignored afterwards.
# Minimum 12 characters. Change the password after the first login.
ADMIN_INITIAL_PASSWORD=""

# --- External cargo API ---------------------------------------------------
EXTERNAL_API_URL=""
EXTERNAL_API_USERNAME=""
EXTERNAL_API_PASSWORD=""
